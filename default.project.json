{
  "name": "OFFSCOPE",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5,
        "EnableMouseLockOption": false,
        "AutoJumpEnabled": false,
        "CharacterWalkSpeed": 16,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 6.5,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 3
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$properties": {
        "Brightness": 2.5,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
